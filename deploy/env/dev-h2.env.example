# Copy to deploy/env/dev-h2.env on the dev H2 host and fill with real values.
# Do not commit deploy/env/dev-h2.env.

WMS_DEV_H2_DB_PASSWORD=replace-with-dev-h2-db-password
WMS_DEV_H2_DB_PORT=15432
WMS_DEV_H2_REDIS_PORT=16379
WMS_HFILE_ACCESS_KEY=replace-with-dev-hfile-access-key
WMS_HFILE_SECRET_KEY=replace-with-dev-hfile-secret-key
WMS_DEV_HFILE_API_PORT=19000
WMS_DEV_HFILE_CONSOLE_PORT=19001
WMS_H9_RENDER_TOKEN=replace-with-dev-h9-render-token
WMS_DEV_H9_RENDER_PORT=18090
WMS_JWT_SECRET=replace-with-dev-jwt-secret-at-least-32-chars
# `just dev-up runtime=dev-h2` 使用的统一运行时配置。
WMS_DEV_INFRA_MODE=compose
WMS_DEV_MIGRATE=1
WMS_DEV_COMPOSE_FILE=deploy/docker-compose.dev-h2.yml
WMS_BIND_ADDR=0.0.0.0:18080
WMS_API_BASE=http://dev-h2.wms.internal:18080
WMS_WEB_ADMIN_DEV_MOCK=0
WMS_WEB_ADMIN_E2E_API_URL=http://dev-h2.wms.internal:18080
# 宿主机 cargo run 连接上方服务时同时设置：
# WMS_DB_URL=postgres://wms_dev_h2:<password>@dev-h2.wms.internal:15432/wms_dev_h2
# WMS_REDIS_URL=redis://dev-h2.wms.internal:16379
# WMS_HFILE_ENDPOINT=http://dev-h2.wms.internal:19000
# WMS_HFILE_REGION=us-east-1
# WMS_HFILE_BUCKET=wms-attachments
# WMS_HFILE_SSE_MODE=none
# WMS_H9_RENDER_WORKER_URL=http://dev-h2.wms.internal:18090/render

# H8 worker is optional. Fill these values before including `h8` in just dev-services.
# WMS_H8_WORKER_API_KEY=replace-with-local-h8-worker-api-key
# H8_CONNECTOR_ID=replace-with-active-local-h8-connector-uuid
# WMS_H8_SECRET_ALIASES={"vault://h8/worker-db":"replace-with-local-worker-password"}

# Comma-separated DNS names allowed for baseline --execute.
# Do not include dev-h2.wms.internal; that alias is dry-run only.
WMS_DEV_DB_HOST_ALLOWLIST=pg-dev.wms.internal
