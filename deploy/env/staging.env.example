# Copy to deploy/env/staging.env on the staging host and fill with real values.
# Do not commit deploy/env/staging.env.

WMS_STAGING_DB_PASSWORD=replace-with-staging-db-password
WMS_JWT_SECRET=replace-with-staging-jwt-secret-at-least-32-chars
WMS_STAGING_API_PORT=18080
WMS_HFILE_ACCESS_KEY=replace-with-staging-hfile-access-key
WMS_HFILE_SECRET_KEY=replace-with-staging-hfile-secret-key
WMS_HFILE_REGION=us-east-1
WMS_STAGING_MINIO_API_PORT=19000
WMS_STAGING_MINIO_CONSOLE_PORT=19001
WMS_H9_RENDER_TOKEN=replace-with-staging-h9-render-token
H8_CONNECTOR_ID=replace-with-active-h8-connector-uuid
H8_OWNER_CODE=ZBPF7
H8_WORKER_ID=h8-erp-worker-staging
WMS_H8_WORKER_API_KEY=replace-with-least-privilege-h8-worker-api-key
WMS_H8_SECRET_ALIASES={"vault://replace-with-worker-password-alias":"replace-with-worker-password","vault://replace-with-probe-password-alias":"replace-with-probe-password"}
