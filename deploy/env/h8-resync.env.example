# Copy to deploy/env/h8-resync.env. This file is for a local H8 resync runtime.
# It is intentionally not a checked-in credential or database configuration.

# The H8 resync database/API may already be running outside dev-h2.
WMS_DEV_INFRA_MODE=none
WMS_DEV_MIGRATE=0
WMS_BIND_ADDR=0.0.0.0:18184
WMS_API_BASE=http://127.0.0.1:18184
WMS_WEB_ADMIN_DEV_MOCK=0
WMS_WEB_ADMIN_E2E_API_URL=http://127.0.0.1:18184

# Fill the actual runtime connection locally; never commit the completed file.
WMS_DB_URL=postgres://runtime_user:replace-with-password@127.0.0.1:5434/runtime_database
WMS_REDIS_URL=redis://127.0.0.1:6379
WMS_JWT_SECRET=replace-with-runtime-jwt-secret-at-least-32-chars
WMS_H9_RENDER_TOKEN=replace-with-runtime-h9-render-token

# Required only when starting the H8 worker with `services=api,h8`.
WMS_H8_WORKER_API_KEY=replace-with-local-h8-worker-api-key
H8_CONNECTOR_ID=replace-with-active-local-h8-connector-uuid
WMS_H8_SECRET_ALIASES={"vault://h8/worker-db":"replace-with-local-worker-password"}
