{
  "name": "@wms/api-client",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "WMS OpenAPI 生成类型与 fetch 客户端封装。",
  "scripts": {
    "gen:schema": "openapi-typescript ../../shared/openapi/openapi.json -o src/schema.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2"
  }
}
