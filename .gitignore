# ============================================================
# wms .gitignore
# 治理原则：禁止任何密钥、构建产物、本地数据进入版本库
# ============================================================

# ---- 环境与密钥 ----
.env
.env.*
!.env.example
deploy/env/*.env
*.pem
*.key
id_rsa
id_rsa.pub
*.pfx
*.p12
*.p12
*.pfx
secrets/
.secrets/

# ---- Rust ----
target/
**/*.rs.bk
*.pdb
Cargo.lock.bak

# ---- Node / 前端 ----
node_modules/
dist/
build/
out/
.next/
.turbo/
.vite/
*.tsbuildinfo
.pnpm-store/
storybook-static/
prototypes/.visual-snapshots/
prototypes/.visual-diffs/
prototypes/.e2e-artifacts/
apps/web-admin/.e2e-artifacts/
apps/customer-portal/.e2e-artifacts/
prototypes/test-results/
test-results/

# ---- Python（治理脚本） ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- 编辑器 / IDE ----
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---- 日志与临时 ----
*.log
logs/
tmp/
.tmp/
var/
artifacts/
*.local

# ---- 真实系统导出数据 ----
docs/legacy-analysis/*.csv

# ---- 测试与覆盖率 ----
coverage/
.coverage
*.lcov
.nyc_output/

# ---- 数据库本地数据 ----
*.sqlite
*.sqlite3
*.db
pgdata/

# ---- OS ----
.AppleDouble
.LSOverride
desktop.ini

# ---- 治理本身 ----
# baseline 文件必须入库（这是治理资产）
# scripts/governance/ 下生成的临时报告不入库
scripts/governance/*.report.json
scripts/governance/.cache/

# mkdocs 构建产物
site/

# ---- Kiro CLI 本地工具配置（agent / commander / skill 定义） ----
# kiro-cli 用，不是项目资产。每个开发机各自维护本地 .kiro/。
.kiro/

# ---- Codex CLI 本地工具配置（agent / plugin / skill 定义） ----
# codex-cli 用，不是项目资产。每个开发机各自维护本地 .codex/。
.codex/

# ---- Claude CLI 本地 worktree ----
.claude/worktrees/

# ---- Understand-Anything 项目图谱本地临时文件 ----
.ua/intermediate/
.ua/diff-overlay.json
.ua/.trash-*/

# ---- 图谱数据（决策：不入库，仅本地工具维护）----
.ua/

# ---- 历史原型资产（决策：不入库，仅本地保留）----
prototypes/

# ---- 本地配置与工具产物 ----
.claude/settings.local.json
.playwright-mcp/
.pi/
