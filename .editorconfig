# EditorConfig: 跨编辑器统一基础格式
# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Rust 用 4 空格（rustfmt 默认）
[*.rs]
indent_size = 4
max_line_length = 100

# Python 用 4 空格（PEP 8）
[*.py]
indent_size = 4
max_line_length = 100

# Markdown 保留行尾空格（用于换行）
[*.md]
trim_trailing_whitespace = false

# Makefile / justfile 必须用 tab
[{Makefile,justfile,*.mk}]
indent_style = tab

# YAML / TOML / JSON
[*.{yml,yaml,toml,json}]
indent_size = 2

# TypeScript / JavaScript
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_size = 2
max_line_length = 100
