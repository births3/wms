{
  "name": "@wms/web-admin",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 9002 --strictPort",
    "build": "pnpm run test:self-checks && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:self-checks": "node self-checks/m1-feature-flag-import-self-check.mjs && node self-checks/m1-special-drug-system-dictionary-self-check.mjs && node self-checks/m1-zone-derived-self-check.mjs && node self-checks/m3-batch-management-slice-self-check.mjs",
    "test:e2e:m1-real": "pnpm --dir ../../prototypes exec playwright test --config=playwright-web-admin-m1-real-config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.0",
    "@wms/api-client": "workspace:*",
    "@wms/ui": "workspace:*",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
