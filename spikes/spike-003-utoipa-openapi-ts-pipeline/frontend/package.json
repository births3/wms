{
  "name": "spike-003-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "SPIKE-003 前端：消费后端 utoipa 生成的 openapi.json，验证 TS 类型自动生成 + 反向编译报错链路",
  "scripts": {
    "gen:schema": "openapi-typescript ../shared/openapi.json -o src/schema.ts",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
