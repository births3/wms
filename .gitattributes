# Git attributes: 强制行尾、二进制、语言识别

# 默认所有文本文件用 LF（防止 Windows 上 CRLF 污染）
* text=auto eol=lf

# Rust
*.rs text eol=lf
Cargo.lock text eol=lf

# TypeScript / JavaScript
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf

# Python
*.py text eol=lf

# 配置
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Shell / Just
*.sh text eol=lf
justfile text eol=lf
Makefile text eol=lf

# 二进制
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary

# linguist 语言识别提示
docs/** linguist-documentation
*.md linguist-detectable=true
