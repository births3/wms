@startuml
title M-CG 单据号生成数据模型

entity document_number_rules {
  * id : uuid
  --
  owner_id : uuid
  document_type : text
  rule_code : text
  rule_name : text
  template : text
  reset_policy : text
  sequence_width : int
  sequence_mode : text
  enabled : boolean
  effective_from : timestamptz
  effective_to : timestamptz
  created_at : timestamptz
  updated_at : timestamptz
  version : bigint
}

entity document_number_counters {
  * id : uuid
  --
  rule_id : uuid
  counter_key : text
  current_value : bigint
  created_at : timestamptz
  updated_at : timestamptz
  version : bigint
}

entity document_number_allocations {
  * id : uuid
  --
  owner_id : uuid
  rule_id : uuid
  document_type : text
  idempotency_key : text
  request_hash : text
  generated_no : text
  sequence_value : bigint
  counter_key : text
  source_module : text
  source_document_id : uuid
  created_at : timestamptz
}

entity system_dictionary_items {
  * id : uuid
  --
  dict_code : text
  item_code : text
  owner_id : uuid
  params : jsonb
  enabled : boolean
  effective_from : timestamptz
  effective_to : timestamptz
}

document_number_rules ||--o{ document_number_counters
document_number_rules ||--o{ document_number_allocations
system_dictionary_items ||..o{ document_number_rules : document_type

note bottom of document_number_rules
owner_id 为空表示全局规则。
owner_id 非空表示货主规则，优先级高于全局规则。
end note

note bottom of document_number_allocations
idempotency_key + owner_id 唯一。
request_hash 用于识别同一幂等键的请求冲突。
generated_no 不修改、不回收。
end note
@enduml
